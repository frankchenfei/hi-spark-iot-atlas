# Response headers for Netlify and Cloudflare Pages.
# Drop this file in the publish root; both platforms read it as-is.
#
# Why the caching rules look like this:
#   - Every JS/CSS reference carries a ?v=<build> query set by tools/apply_script_profiles.mjs,
#     so a new build produces new URLs and assets can be cached hard.
#   - HTML must revalidate, otherwise visitors keep an old shell that points at
#     asset URLs from the previous build.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/logos/*
  Cache-Control: public, max-age=31536000, immutable

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
